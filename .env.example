# Copy this file to .env for local development: cp .env.example .env
# .env is ignored by git. Never commit real credentials.

# Local database and Redis (used by infra/docker-compose.yml)
POSTGRES_USER=doorpin
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=doorpin
POSTGRES_PORT=5433
REDIS_PORT=6380

# API server
DATABASE_URL=postgres://doorpin:change-me-local-only@127.0.0.1:5433/doorpin
REDIS_URL=redis://127.0.0.1:6380
API_HOST=127.0.0.1
API_PORT=3000
# trace, debug, info, warn, error or fatal
LOG_LEVEL=info

# Web app (only VITE_ variables reach the browser)
# Development map style. Replaced by our own PMTiles in MVP Phase 5.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
